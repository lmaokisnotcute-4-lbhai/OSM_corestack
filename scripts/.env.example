# Copy this file to .env and fill in your values.
# Never commit the actual .env file — it is listed in .gitignore.

# Your CoREStack API key
# Get one from https://dashboard.core-stack.org (requires Org Admin account)
CORESTACK_API_KEY=your_corestack_api_key_here

# Your Google Cloud Project ID (the one linked to your Earth Engine account)
GEE_PROJECT=your-gcp-project-id
