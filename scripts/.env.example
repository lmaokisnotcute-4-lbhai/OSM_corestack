# Copy this file to .env and fill in your values.
# ── CoREStack API ────────────────────────────────────────────────
# Get from https://dashboard.core-stack.org (requires Org Admin account)
CORESTACK_API_KEY=your_corestack_api_key_here

# ── Google Earth Engine ──────────────────────────────────────────
# Your GCP project ID linked to your Earth Engine account
GEE_PROJECT=your-gcp-project-id

# ── OpenStreetMap Wiki ───────────────────────────────────────────
# Your OSM wiki username (e.g. Sweek10)
WIKI_USER=your_osm_username
# Bot name created at https://wiki.openstreetmap.org/wiki/Special:BotPasswords
WIKI_BOT_NAME=your_bot_name
# Bot password from the same page
WIKI_BOT_PASS=your_bot_password
